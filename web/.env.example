# Copy to .env and fill in. Never commit real values.
# Local Postgres runs on port 5433 (container esus-db, see root AGENTS.md).

# App database (Prisma).
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/agenda_web"

# Separate database used by the test suite (npm test). Wiped on every run.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/agenda_web_test"

# Better Auth (ADR-0004). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="CHANGE_ME"
BETTER_AUTH_URL="http://localhost:3001"

# File storage for uploaded images (ADR-0015). Google Drive in any real deploy:
# an OAuth client of a Google Cloud project with the Drive API enabled, a refresh
# token of the platform's Google account (scope https://www.googleapis.com/auth/drive.file)
# and, optionally, the folder created by `npm run drive:create-folder`. See docs/ARMAZENAMENTO_GOOGLE_DRIVE.md.
# Without these, development and tests store files on local disk (LOCAL_FILE_STORAGE_DIR,
# default web/.storage); production refuses uploads unless ALLOW_LOCAL_FILE_STORAGE=true.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""
