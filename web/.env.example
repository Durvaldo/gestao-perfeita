# Copy to .env and fill in. Never commit real values.
# Local Postgres runs on port 5433 (container esus-db, see root AGENTS.md).

# App database (Prisma).
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/agenda_web"

# Separate database used by the test suite (npm test). Wiped on every run.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/agenda_web_test"

# Better Auth (ADR-0004). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="CHANGE_ME"
BETTER_AUTH_URL="http://localhost:3001"
